#!/bin/bash
#PBS -N rbj-c-medium
#PBS -P xd2
#PBS -q normalsr
#PBS -l walltime=03:00:00
#PBS -l mem=1000GB
#PBS -l ncpus=208
#PBS -l jobfs=400GB
#PBS -l storage=scratch/xd2+gdata/fp50
#PBS -l wd
#PBS -W umask=0022
#PBS -o /scratch/xd2/sg8812/morrow2026-bjacobi-matrix-20260820T070948Z/production/results/cockett/medium/run.out
#PBS -e /scratch/xd2/sg8812/morrow2026-bjacobi-matrix-20260820T070948Z/production/results/cockett/medium/run.err

source /etc/profile
set -euo pipefail

module use /g/data/fp50/modules
module load firedrake/main-20260806

export PYTHONPATH=/scratch/xd2/sg8812/morrow2026-bjacobi-matrix-20260820T070948Z/source/g-adopt:/scratch/xd2/sg8812/morrow2026-bjacobi-matrix-20260820T070948Z/source/gwassess:/scratch/xd2/sg8812/morrow2026-bjacobi-matrix-20260820T070948Z/source/omega:${PYTHONPATH:-}
export PYTHONDONTWRITEBYTECODE=1
export OMPI_MCA_io=ompio
export OMP_NUM_THREADS=1
export NCI_PROJECT=xd2

mkdir -p "$PBS_JOBFS/pyop2" "$PBS_JOBFS/tsfc" "$PBS_JOBFS/xdg"
export PYOP2_CACHE_DIR="$PBS_JOBFS/pyop2"
export FIREDRAKE_TSFC_KERNEL_CACHE_DIR="$PBS_JOBFS/tsfc"
export XDG_CACHE_HOME="$PBS_JOBFS/xdg"
export PETSC_OPTIONS='-log_view :/scratch/xd2/sg8812/morrow2026-bjacobi-matrix-20260820T070948Z/production/results/cockett/medium/run.profile'

cd /scratch/xd2/sg8812/morrow2026-bjacobi-matrix-20260820T070948Z/source/morrow/parallel_scaling

echo "=== Job info ==="
echo "Phase: production"
echo "Case: cockett"
echo "Scale: medium"
echo "Solver: bjacobi"
echo "Nodes: 2"
echo "CPUs: $PBS_NCPUS"
echo "Walltime limit: 03:00:00"
echo "Firedrake module: firedrake/main-20260806"
echo "G-ADOPT source: /scratch/xd2/sg8812/morrow2026-bjacobi-matrix-20260820T070948Z/source/g-adopt"
echo "PETSC_OPTIONS: $PETSC_OPTIONS"
echo "Date: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
echo "Command: python /scratch/xd2/sg8812/morrow2026-bjacobi-matrix-20260820T070948Z/source/morrow/parallel_scaling/cockett_3d.py --nx 152 --nz 196 --degree 1 --dt 300 --steps 100 --solver bjacobi --refinement-levels 0 --profile"
echo "================"

mpiexec -np "$PBS_NCPUS" bash -c '
  export MPLCONFIGDIR="$PBS_JOBFS/mpl.${OMPI_COMM_WORLD_RANK:-0}"
  mkdir -p "$MPLCONFIGDIR"
  exec "$@"
' _ python /scratch/xd2/sg8812/morrow2026-bjacobi-matrix-20260820T070948Z/source/morrow/parallel_scaling/cockett_3d.py --nx 152 --nz 196 --degree 1 --dt 300 --steps 100 --solver bjacobi --refinement-levels 0 --profile

test -s /scratch/xd2/sg8812/morrow2026-bjacobi-matrix-20260820T070948Z/production/results/cockett/medium/run.profile
echo "=== Job completed: $(date -u +%Y-%m-%dT%H:%M:%SZ) ==="
