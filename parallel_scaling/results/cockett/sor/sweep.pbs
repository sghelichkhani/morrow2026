#!/bin/bash
#PBS -N rs-cock-sor-sweep
#PBS -P xd2
#PBS -q normalsr
#PBS -l walltime=03:00:00
#PBS -l mem=500GB
#PBS -l ncpus=104
#PBS -l jobfs=400GB
#PBS -l storage=scratch/xd2+gdata/fp50
#PBS -l wd
#PBS -W umask=0022
#PBS -o /scratch/xd2/sg8812/morrow2026/parallel_scaling/results/cockett/sor/sweep.out
#PBS -e /scratch/xd2/sg8812/morrow2026/parallel_scaling/results/cockett/sor/sweep.err

source /etc/profile
set -e
module use /g/data/fp50/modules
module load firedrake/main-20260806

export PYTHONPATH="/scratch/xd2/sg8812/g-adopt-worktrees/sghelichkhani/richardson":"/scratch/xd2/sg8812/gwassess":"/scratch/xd2/sg8812/omega":${PYTHONPATH}
export PYTHONDONTWRITEBYTECODE=1

export OMPI_MCA_io="ompio"
export OMP_NUM_THREADS=1
export NCI_PROJECT=xd2
export MPLCONFIGDIR=$PBS_JOBFS/matplotlib
export PETSC_OPTIONS="-log_view :/scratch/xd2/sg8812/morrow2026/parallel_scaling/results/cockett/sor/sweep.profile"

cd /scratch/xd2/sg8812/morrow2026/parallel_scaling

echo "=== Job info ==="
echo "Case: cockett"
echo "Solver: sor"
echo "Scale: sweep"
echo "Degree: 1"
echo "Nodes: 1"
echo "CPUs: 104"
echo "Date: $(date)"
echo "G-ADOPT commit: $(git -C /scratch/xd2/sg8812/g-adopt-worktrees/sghelichkhani/richardson rev-parse HEAD)"
echo "Morrow commit: $(git -C /scratch/xd2/sg8812/morrow2026 rev-parse HEAD)"
echo "Driver SHA256: $(sha256sum /scratch/xd2/sg8812/morrow2026/parallel_scaling/cockett_3d.py | cut -d' ' -f1)"
echo "Solver SHA256: $(sha256sum /scratch/xd2/sg8812/morrow2026/parallel_scaling/solvers/sor.py | cut -d' ' -f1)"
echo "Firedrake module: $LOADEDMODULES"
echo "PETSC_OPTIONS: $PETSC_OPTIONS"
echo "================"

mpiexec -np $PBS_NCPUS python /scratch/xd2/sg8812/morrow2026/parallel_scaling/cockett_3d.py --nx 120 --nz 156 --degree 1 --steps 30 --solver sor --refinement-levels 0 --profile 2>&1

test -s /scratch/xd2/sg8812/morrow2026/parallel_scaling/results/cockett/sor/sweep.profile

echo "=== Job completed: $(date) ==="
