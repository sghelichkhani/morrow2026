#!/bin/bash
#PBS -N rs-murr-vlumping-smoke
#PBS -P xd2
#PBS -q normalsr
#PBS -l walltime=06:00:00
#PBS -l mem=500GB
#PBS -l ncpus=104
#PBS -l jobfs=400GB
#PBS -l storage=scratch/xd2+gdata/xd2+gdata/fp50
#PBS -l wd
#PBS -W umask=0022
#PBS -o /scratch/xd2/sg8812/g-adopt-worktrees/sghelichkhani/richardson/tests/parallel_scaling_richards/results/murrumbidgee/vlumping/smoke.out
#PBS -e /scratch/xd2/sg8812/g-adopt-worktrees/sghelichkhani/richardson/tests/parallel_scaling_richards/results/murrumbidgee/vlumping/smoke.err

source /etc/profile
module use /g/data/fp50/modules
module load firedrake/main-20260401

export PYTHONPATH="/scratch/xd2/sg8812/g-adopt-worktrees/sghelichkhani/richardson":"/scratch/xd2/sg8812/Irksome":"/scratch/xd2/sg8812/local/firedrake-main-20260401/lib/python3.11/site-packages":"/scratch/xd2/sg8812/firedrake-override":"/scratch/xd2/sg8812/gwassess":${PYTHONPATH}
export PYTHONDONTWRITEBYTECODE=1

export OMPI_MCA_io="ompio"
export OMP_NUM_THREADS=1
export MPLCONFIGDIR=$PBS_JOBFS/matplotlib
# Note: -log_view / -memory_view require PETSc init-time support that
# Firedrake/petsc4py does not provide. Per-step timing and RSS are
# tracked in Python; snes_view dumps the full solver hierarchy.

cd /scratch/xd2/sg8812/g-adopt-worktrees/sghelichkhani/richardson/tests/parallel_scaling_richards

echo "=== Job info ==="
echo "Case: murrumbidgee"
echo "Solver: vlumping"
echo "Scale: smoke"
echo "Nodes: 1"
echo "CPUs: 104"
echo "Date: $(date)"
echo "================"

mpiexec -np $PBS_NCPUS python /scratch/xd2/sg8812/g-adopt-worktrees/sghelichkhani/richardson/tests/parallel_scaling_richards/murrumbidgee_3d.py --horiz-res 1775 --layers 150 --solver vlumping --refinement-levels 0 --dt-init 60 --dt-max 43200 --dt-growth 1.5 --dt-shrink 0.5 --t-final 2592000 --data-dir /scratch/xd2/sg8812/g-adopt-worktrees/sghelichkhani/richardson/tests/parallel_scaling_richards/murrumbidgee_data 2>&1

echo "=== Job completed: $(date) ==="
