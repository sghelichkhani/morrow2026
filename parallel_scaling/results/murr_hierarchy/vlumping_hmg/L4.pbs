#!/bin/bash
#PBS -N rs-murr-vlumping_hmg-L4
#PBS -P xd2
#PBS -q normalsr
#PBS -l walltime=03:00:00
#PBS -l mem=4000GB
#PBS -l ncpus=832
#PBS -l jobfs=400GB
#PBS -l storage=scratch/xd2+gdata/xd2+gdata/fp50
#PBS -l wd
#PBS -W umask=0022
#PBS -o /scratch/xd2/sg8812/morrow2026/parallel_scaling/results/murr_hierarchy/vlumping_hmg/L4.out
#PBS -e /scratch/xd2/sg8812/morrow2026/parallel_scaling/results/murr_hierarchy/vlumping_hmg/L4.err

source /etc/profile
module use /g/data/fp50/modules
module load firedrake/main-20260716

export PYTHONPATH="/scratch/xd2/sg8812/g-adopt-worktrees/sghelichkhani/richardson":"/scratch/xd2/sg8812/gwassess":"/scratch/xd2/sg8812/omega":${PYTHONPATH}
export PYTHONDONTWRITEBYTECODE=1

export OMPI_MCA_io="ompio"
export OMP_NUM_THREADS=1
export MPLCONFIGDIR=$PBS_JOBFS/matplotlib
# Note: -log_view / -memory_view require PETSc init-time support that
# Firedrake/petsc4py does not provide. Per-step timing and RSS are
# tracked in Python; snes_view dumps the full solver hierarchy.

cd /scratch/xd2/sg8812/morrow2026/parallel_scaling

echo "=== Job info ==="
echo "Case: murr_hierarchy"
echo "Solver: vlumping_hmg"
echo "Scale: L4"
echo "Degree: 1"
echo "Nodes: 8"
echo "CPUs: 832"
echo "Date: $(date)"
echo "================"

mpiexec -np $PBS_NCPUS python /scratch/xd2/sg8812/morrow2026/parallel_scaling/murrumbidgee_3d.py --horiz-res 620 --layers 300 --solver vlumping_hmg --refinement-levels 4 --dt-init 60 --dt-max 43200 --dt-growth 1.5 --dt-shrink 0.5 --t-final 2592000 --data-dir /scratch/xd2/sg8812/morrow2026/parallel_scaling/murrumbidgee_data 2>&1

echo "=== Job completed: $(date) ==="
