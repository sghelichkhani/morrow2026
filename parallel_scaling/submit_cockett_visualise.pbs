#!/bin/bash
# Cockett 3D box — high-resolution movie of the infiltration front.
#
# Same footprint as the `large` scaling case (8 normalsr nodes, 832 CPUs,
# 4 TB RAM): 240 x 240 x 312, degree 1 (~144M DOF). This is the exact
# mesh+solver+degree of the frozen `large` scaling point, where vlumping
# runs at ~17.5 s/step, so 108 steps finishes in ~35 min.
#
# Degree 1 (not 2): DQ2 at this resolution costs ~330 linear iterations
# and ~14 min/step -- vlumping's vertical lumping is only mesh-independent
# at degree 1, and it degrades badly at degree 2. For a full-domain movie
# (screen resolution) the high-order CG2 buys nothing, so we render at DQ1
# -> CG1. Keep DQ2 only for a static zoomed still if ever needed.
#
# Solver: vlumping_inexact -- the g-adopt auto-default for extruded
# Cartesian meshes, mesh-independent at DQ1 (~20 iters vs hundreds for
# bjacobi). Timestep loosened to 2400 s (108 steps to 72 h); for a
# visualisation the 600 s scaling resolution is overkill.
#
# Output: moisture content only, one field per frame, every 6 steps (a
# frame every 4 h sim time = ~19 frames). At DQ1->CG1 each frame is
# ~200 MB, so the whole movie is a few GB.
#
# Submit with:  module load git && qsub submit_cockett_visualise.pbs
#
#PBS -N rs-cock-vis
#PBS -P xd2
#PBS -q normalsr
#PBS -l walltime=02:00:00
#PBS -l mem=4000GB
#PBS -l ncpus=832
#PBS -l jobfs=400GB
#PBS -l storage=scratch/xd2+gdata/xd2+gdata/fp50
#PBS -l wd
#PBS -W umask=0022
#PBS -o /scratch/xd2/sg8812/morrow2026/parallel_scaling/results/cockett_hires/run.out
#PBS -e /scratch/xd2/sg8812/morrow2026/parallel_scaling/results/cockett_hires/run.err

source /etc/profile
module use /g/data/fp50/modules
module load firedrake/main-20260514

export PYTHONPATH="/scratch/xd2/sg8812/g-adopt-worktrees/sghelichkhani/richardson":"/scratch/xd2/sg8812/Irksome":"/scratch/xd2/sg8812/local/firedrake-main-20260514/lib/python3.11/site-packages":"/scratch/xd2/sg8812/firedrake-override":"/scratch/xd2/sg8812/gwassess":${PYTHONPATH}
export PYTHONDONTWRITEBYTECODE=1

export OMPI_MCA_io="ompio"
export OMP_NUM_THREADS=1
export MPLCONFIGDIR=$PBS_JOBFS/matplotlib

SCALING_DIR=/scratch/xd2/sg8812/morrow2026/parallel_scaling
OUTPUT_DIR=$SCALING_DIR/results/cockett_hires
mkdir -p $OUTPUT_DIR
cd $SCALING_DIR

echo "=== Job info ==="
echo "Case: cockett (visualisation movie, DQ1)"
echo "Mesh: 240x240x312, degree 1"
echo "Nodes: 8  CPUs: 832"
echo "Solver: vlumping_inexact"
echo "dt: 2400 s (108 steps to 72 h)"
echo "Output: theta only (CG1), every 6 steps (~19 frames)"
echo "Date: $(date)"
echo "================"

mpiexec -np $PBS_NCPUS python $SCALING_DIR/cockett_visualise.py \
    --nx 240 --nz 312 --degree 1 --dt 2400 --solver vlumping_inexact \
    --output-every 6 --output-dir $OUTPUT_DIR 2>&1

echo "=== Job completed: $(date) ==="
