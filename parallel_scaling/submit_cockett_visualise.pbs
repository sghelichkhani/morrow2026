#!/bin/bash
# Cockett 3D box — infiltration-front movie (sweep scale, DQ1, BoomerAMG).
#
# Mesh 120 x 120 x 156 (~18M DOF, DQ1) on 1 normalsr node (104 CPUs,
# 500 GB) — the `sweep` scaling scale. This is the cost-vs-resolution
# compromise for the movie: full DQ2 at 240^3 costs ~14 min/step, and even
# DQ1 at 240^3 is ~4.5 h of compute, whereas 120^3 finishes comfortably
# inside a couple of hours while still being plenty detailed for a
# full-domain animation.
#
# Solver: boomeramg. The scaling study shows BoomerAMG is the most
# mesh-independent Cockett preconditioner (late-step ~21-23 iterations at
# every scale) and its per-step solve actually beat vlumping at large; its
# only drawback was a ~210 s one-time AMG setup, which amortises to nothing
# over a 108-step movie. vlumping's vertical lumping is tuned to the
# mass-dominated small-dt regime and degrades badly at the large dt used
# here, so BoomerAMG is the better fit for this operating point.
#
# Timestep 2400 s (108 steps to 72 h). Output: moisture content and pressure
# head, CG1, every 6 steps (a frame every 4 h sim time = ~19 frames, ~hundreds
# of MB total at this resolution). The front isosurface is contoured from the
# pressure head (continuous across the sand/loam blocks) and coloured by
# moisture content; theta jumps at soil interfaces so it can't drive a clean
# isosurface on its own.
#
# Submit with:  module load git && qsub submit_cockett_visualise.pbs
#
#PBS -N rs-cock-vis
#PBS -P xd2
#PBS -q normalsr
#PBS -l walltime=02:00:00
#PBS -l mem=500GB
#PBS -l ncpus=104
#PBS -l jobfs=100GB
#PBS -l storage=scratch/xd2+gdata/xd2+gdata/fp50
#PBS -l wd
#PBS -W umask=0022
#PBS -o /scratch/xd2/sg8812/morrow2026/parallel_scaling/results/cockett_hires/run.out
#PBS -e /scratch/xd2/sg8812/morrow2026/parallel_scaling/results/cockett_hires/run.err

source /etc/profile
module use /g/data/fp50/modules
module load firedrake/main-20260514

export PYTHONPATH="/scratch/xd2/sg8812/g-adopt-worktrees/sghelichkhani/richardson":"/scratch/xd2/sg8812/Irksome":"/scratch/xd2/sg8812/local/firedrake-main-20260514/lib/python3.11/site-packages":"/scratch/xd2/sg8812/firedrake-override":"/scratch/xd2/sg8812/gwassess":${PYTHONPATH}
export PYTHONDONTWRITEBYTECODE=1

export OMPI_MCA_io="ompio"
export OMP_NUM_THREADS=1
export MPLCONFIGDIR=$PBS_JOBFS/matplotlib

SCALING_DIR=/scratch/xd2/sg8812/morrow2026/parallel_scaling
OUTPUT_DIR=$SCALING_DIR/results/cockett_hires
mkdir -p $OUTPUT_DIR
cd $SCALING_DIR

echo "=== Job info ==="
echo "Case: cockett (visualisation movie, DQ1)"
echo "Mesh: 120x120x156, degree 1 (~18M DOF)"
echo "Nodes: 1  CPUs: 104"
echo "Solver: boomeramg"
echo "dt: 2400 s (108 steps to 72 h)"
echo "Output: theta + pressure head (CG1), every 6 steps (~19 frames)"
echo "Date: $(date)"
echo "================"

mpiexec -np $PBS_NCPUS python $SCALING_DIR/cockett_visualise.py \
    --nx 120 --nz 156 --degree 1 --dt 2400 --solver boomeramg \
    --output-every 6 --output-dir $OUTPUT_DIR 2>&1

echo "=== Job completed: $(date) ==="
